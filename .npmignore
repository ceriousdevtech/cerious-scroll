# Ignore development files
.github/
.git/
.gitignore
.DS_Store

# Tests
tests/
vitest.config.ts
*.test.ts
*.spec.ts

# Demo files (use live demo site instead)
demo/

# Documentation source (markdown available in npm)
docs/ARCHITECTURE.md
docs/IMPLEMENTATION_GUIDE.md
GITHUB_PAGES_SETUP.md

# Development configs
tsconfig.json
.editorconfig
.eslintrc*
.prettierrc*

# Build scripts
scripts/

# Source files (only include compiled dist)
cerious-scroll/**/*.ts
!cerious-scroll/**/*.d.ts

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.sublime-*
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Misc
*.log
.env
.env.local
coverage/
.nyc_output/

# Keep only what users need
# The following will be included:
# - dist/ (compiled files)
# - LICENSE files
# - README.md
# - CHANGELOG.md
# - package.json
